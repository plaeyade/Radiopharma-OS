# Radiopharma OS — Fase 1: despliegue de infraestructura
# Copiar a .env y ajustar. NUNCA subir el .env real al repositorio.
# Disciplina de plataforma honesta: hasta que un endpoint esté registrado
# y el sondeo real responda, el conector sigue reportando su marcador
# honesto (no_configurado / fallo_conexion / sin_runtime). Nada se simula.

# ── Seguridad base ──────────────────────────────────────────────────────
JWT_SECRET=cambia-esto-en-produccion
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esto-en-produccion
INFLUX_TOKEN=cambia-esto-en-produccion

# ── OSRM (logistics twin, process-service :8007) ───────────────────────
# Servidor de rutas propio (perfil "mapa" del compose) o público de demo.
# Tras levantarlo: registrar en POST /api/v1/osrm/servers y sondear.
OSRM_URL=http://localhost:5000
# OSRM_URL=https://router.project-osrm.org   # solo demos, sin SLA

# ── MQTT (EDS cap. 31 RTMSIL, telemetry-service :8006) ─────────────────
# Broker levantado por el perfil "conectores". Registrar como conector
# tipo mqtt en POST /api/v1/scada/connectors.
MQTT_URL=mqtt://localhost:1883

# ── BentoML (surrogate-service :8008, EDS 20.10-20.11) ──────────────────
# Servidor de serving de modelos ML. Sin él, /api/v1/serving/* responde
# 503 honesto y ei_core declara `sin_runtime`.
BENTOML_URL=http://localhost:3000

# ── GenAI (EDS cap. 45, surrogate-service :8008) ───────────────────────
# Proveedores OpenAI-compatibles (embeddings y chat). Sin ellos, embeddings
# e índices semánticos permanecen `no_configurado`.
GENAI_EMBEDDINGS_URL=http://localhost:8081
GENAI_LLM_URL=http://localhost:8082

# ── Fuentes nucleares (Informe 19.10-19.13, nuclear-data-service :8001) ─
EXFOR_URL=https://www-nds.iaea.org/exfor
NNDC_URL=https://www.nndc.bnl.gov
# Directorio local con salidas reales de SRIM (CSV energia_mev,stopping_power)
SRIM_DIR=/data/srim
